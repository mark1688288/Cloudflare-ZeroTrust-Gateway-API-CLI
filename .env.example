# Copy to .env (never commit .env). Required from Phase 4 (`lists`, later diff/apply).
# Put real values only in .env -- not in this example file.

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# suggested (Phase 9) also needs Account → Account Analytics → Read
# on the same token. Missing that permission is a warning, not a failed compile.

